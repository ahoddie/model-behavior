# Copy to web/.env.local and fill in what you need. Next reads .env.local for the site; scripts/env.ts loads the same
# file for the importers and other scripts. Every variable is optional. A blank key skips the importer that needs it.
# Commented-out lines show the default; uncomment one only to change it (a blank value is not the same as unset).

# --- Database ---
# Postgres connection string. Defaults to the local database from docker-compose.yml.
DATABASE_URL=postgres://mb:mb_local_only@127.0.0.1:5433/model_behavior
# Most connections the pool opens (default 8). Set it low (1-3) against a hosted pooler such as Neon's.
# PG_POOL_MAX=8

# --- Data source keys (all free) ---
# api.data.gov key, used for the FEC and Regulations.gov. DEMO_KEY works but allows few calls an hour.
DATA_GOV_KEY=DEMO_KEY
# Congress.gov API key. Without it the Congress importer is skipped.
CONGRESS_API_KEY=
# OpenStates API key for state bills. Without it the state-bill importers are skipped.
OPENSTATES_API_KEY=
# X (Twitter) API bearer token. Without it posts from X are skipped.
X_BEARER_TOKEN=
# Threads API token. Without it posts from Threads are skipped.
THREADS_ACCESS_TOKEN=
# Socrata dataset id for New York lobbying filings, if the state moves it.
# NY_LOBBY_DATASET=8bmh-tuz3

# --- Local model (labels quotes, tags filings, extracts records) ---
# Any OpenAI-compatible server. Defaults to Ollama on this machine.
# LLM_BASE_URL=http://localhost:11434/v1
# Model name on that server. ANALYSIS_MODEL is read as a fallback for LLM_MODEL, and by analyze.ts and tag-filings.ts.
# LLM_MODEL=qwen2.5:7b-instruct
# ANALYSIS_MODEL=
# Ollama's own address, for analyze.ts and tag-filings.ts.
# OLLAMA_HOST=http://localhost:11434
# Bearer token for a hosted endpoint. Leave blank for Ollama.
# LLM_API_KEY=
# Requests in flight at once, and the longest rate-limit wait in seconds before a job stops.
# LLM_CONCURRENCY=1
# LLM_MAX_WAIT_S=90
# Where model answers are cached. Defaults to data/cache/llm.
# LLM_CACHE_DIR=

# --- Position finder (scripts/importers/statements/positions) ---
# With neither set, the finder writes briefs to data/cache/claude instead of calling the API.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# Model the finder uses. Defaults to claude-sonnet-5-5.
# POSITIONS_MODEL=claude-sonnet-5-5

# --- Transcripts ---
# Model for the Python `whisper` command (default base.en), or a whisper.cpp model file path for `whisper-cli`.
# WHISPER_MODEL_NAME=base.en
# WHISPER_MODEL=

# --- Time and size caps (used by the nightly job; 0 or unset means no cap) ---
# ANALYZE_BUDGET_MIN=
# NEWS_BUDGET_MIN=
# NEWS_MAX_ACTORS=
# REGULATIONS_BUDGET_MIN=
# Most OpenStates calls per run (default 400).
# OPENSTATES_BUDGET=400
# FEC: set to 1 to scan committee receipts even on DEMO_KEY, or list donor node ids (comma-separated) to fetch only those.
# FEC_COMMITTEES=
# FEC_DONORS_ONLY=

# --- Hosted site ---
# When both are set, importers tell the hosted site to refresh its pages after a run (POST $SITE_URL/api/revalidate).
# Without them they refresh the local site on port 3010. The site only accepts the call when REVALIDATE_SECRET matches.
# SITE_URL=
# REVALIDATE_SECRET=

# --- Development only ---
# Build into another folder than .next, so a test build does not replace the one the running site uses.
# NEXT_DIST_DIR=.next-verify
# Independent matching attributes a person needs before the entity resolver merges on its own (default 2).
# ER_PERSON_AUTO_GROUPS=2
# Print the money-chain builder's edges whose name contains this text, then stop.
# DEBUG_EDGE=
